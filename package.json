{
  "name": "artplayer-plugin-smart-buffer",
  "version": "1.0.1",
  "description": "Smart video loading and concurrent buffer engine plugin for ArtPlayer",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.mjs",
    "dist/*.d.ts",
    "dist/*.d.mts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "artplayer",
    "artplayer-plugin",
    "hls",
    "m3u8",
    "smart-buffer",
    "video-preload",
    "buffer-engine"
  ],
  "author": "Troray (https://github.com/Troray)",
  "homepage": "https://github.com/Troray/artplayer-plugin-smart-buffer#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Troray/artplayer-plugin-smart-buffer.git"
  },
  "bugs": {
    "url": "https://github.com/Troray/artplayer-plugin-smart-buffer/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "artplayer": ">=5.0.0",
    "hls.js": ">=1.0.0"
  },
  "devDependencies": {
    "artplayer": "^5.4.0",
    "hls.js": "^1.7.4",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
